# Copy to .env (never commit .env). Everything is optional.

# GitHub: raises the public API limit from 60 to 5,000 requests/hour.
# A classic token with NO scopes is enough (public data only).
GITHUB_TOKEN=

# LLM second reviewer (run with --llm). Any OpenAI-compatible endpoint works:
#   OpenAI   LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4o-mini
#   Groq     LLM_BASE_URL=https://api.groq.com/openai/v1                         LLM_MODEL=llama-3.3-70b-versatile
#   Gemini   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
#   Ollama   LLM_BASE_URL=http://localhost:11434/v1                              LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
